      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "targets": [
        {
          "expr": "last_over_time(puck_plex_streams_playing[2m])",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
