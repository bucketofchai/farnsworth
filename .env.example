# Copy to .env, or run scripts/install.sh. Do not commit .env or proton.env.
PUID=1000
PGID=1000
TZ=UTC
VERSION=docker
PLEX_CONFIG=/var/lib/plexmediaserver
REMOTE=user@host
REMOTE_DIR=/srv/farnsworth/puck-plex

# Library disk. TV, Movies, and Downloads are directories under this path.
MEDIA_ROOT=/srv/media
# App data (qBit, Gluetun, Sonarr, Grafana, and the rest).
CONFIG_ROOT=/srv/farnsworth
# Host directory mounted read-only into chat for disk stats.
HOST_ROOT_PATH=/
VPN_COUNTRY=Switzerland
CHAT_IMAGE=puck-plex-chat:local

QBIT_PUID=1000
QBIT_PGID=1000
QBIT_WEBUI_PORT=8080
QBIT_TORRENTING_PORT=6881
QBIT_CONFIG=/srv/farnsworth/qbittorrent/config
QBIT_DOWNLOADS=/srv/media/Downloads
GLUETUN_CONFIG=/srv/farnsworth/gluetun

LAN_IP=192.0.2.10
LAN_CIDR=192.0.2.0/24
# Optional second subnet, comma-separated. Leave empty if there is none.
EXTRA_CIDRS=
# LAN_CIDR, EXTRA_CIDRS, and the docker bridge range. scripts/install.sh writes this.
FIREWALL_OUTBOUND_SUBNETS=192.0.2.0/24,172.16.0.0/12
PLEX_URL=http://192.0.2.10:32400

# Used by plex-qbit and qbit-organize-scan. Do not commit.
PLEX_TOKEN=change-me
QBIT_USER=
QBIT_PASS=
PLEX_QBIT_THROTTLE_ON=wan
PLEX_QBIT_DATA=/srv/farnsworth/plex-qbit
QBIT_ORGANIZE_DATA=/srv/farnsworth/qbit-organize
IMDB_DAILY_DATA=/srv/farnsworth/imdb-daily
OLLAMA_DATA=/srv/farnsworth/ollama
OLLAMA_MODEL=qwen2.5:1.5b
# Chat listens on 127.0.0.1 and LAN_IP.
PLEX_CHAT_PORT=7680
PLEX_CHAT_USER=change-me
PLEX_CHAT_PASSWORD=change-me
MAX_TORRENT_GIB=20
SONARR_CONFIG=/srv/farnsworth/sonarr/config
RADARR_CONFIG=/srv/farnsworth/radarr/config
# Forms login for the LAN UIs. API keys used by Bazarr stay in each app's config.
SONARR_AUTH_USER=change-me
SONARR_AUTH_PASSWORD=change-me
RADARR_AUTH_USER=change-me
RADARR_AUTH_PASSWORD=change-me
BAZARR_CONFIG=/srv/farnsworth/bazarr/config
NTFY_DATA=/srv/farnsworth/ntfy
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_DATA=/srv/farnsworth/grafana
VM_DATA=/srv/farnsworth/victoriametrics
VL_DATA=/srv/farnsworth/victorialogs
ALLOY_DATA=/srv/farnsworth/alloy
GLUETUN_CONTROL_USER=
GLUETUN_CONTROL_PASSWORD=
