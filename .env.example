PUID=997
PGID=984
TZ=America/New_York
VERSION=docker
PLEX_CONFIG=/var/lib/plexmediaserver
REMOTE=klg@puck
REMOTE_DIR=/home/klg/puck-plex
QBIT_PUID=1000
QBIT_PGID=1000
QBIT_WEBUI_PORT=8080
QBIT_TORRENTING_PORT=6881
QBIT_CONFIG=/home/klg/qbittorrent/config
QBIT_DOWNLOADS=/mnt/usbdrive/Downloads
GLUETUN_CONFIG=/home/klg/gluetun
LAN_IP=192.168.1.8
PLEX_URL=http://192.168.1.8:32400
# Used by plex-qbit and qbit-organize-scan. Do not commit.
PLEX_TOKEN=change-me
# Optional. plex-qbit uses localhost qBit (Gluetun) without these when LocalHostAuth is off.
QBIT_USER=
QBIT_PASS=
# wan = throttle only for remote Plex streams; all = any active stream
PLEX_QBIT_THROTTLE_ON=wan
PLEX_QBIT_DATA=/home/klg/plex-qbit
QBIT_ORGANIZE_DATA=/home/klg/qbit-organize
# Daily IMDb Top 250 picker state and dataset cache
IMDB_DAILY_DATA=/home/klg/imdb-daily
OLLAMA_DATA=/home/klg/ollama
OLLAMA_MODEL=qwen2.5:1.5b
# Host-networked like Plex: http://127.0.0.1:7680 and http://LAN_IP:7680
PLEX_CHAT_PORT=7680
PLEX_CHAT_USER=change-me
PLEX_CHAT_PASSWORD=change-me
# Drop search hits larger than this (4K remuxes). Typical 1080p still passes. 0 disables.
MAX_TORRENT_GIB=20
SONARR_CONFIG=/home/klg/sonarr/config
RADARR_CONFIG=/home/klg/radarr/config
BAZARR_CONFIG=/home/klg/bazarr/config
NTFY_DATA=/home/klg/ntfy
# Grafana admin. Do not commit the live password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_DATA=/home/klg/grafana
VM_DATA=/home/klg/victoriametrics
VL_DATA=/home/klg/victorialogs
ALLOY_DATA=/home/klg/alloy
# Optional. puck-metrics scrapes Gluetun's localhost control API.
GLUETUN_CONTROL_USER=
GLUETUN_CONTROL_PASSWORD=
